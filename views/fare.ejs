<%- include('partials/header') %>
<section class="journey-hero"><div><span class="eyebrow">Journey planner</span><h1>Where are you going?</h1><p>Plan your metro journey across Ahmedabad, Gandhinagar and GIFT City with actual distance, stops and interchange guidance.</p></div><div class="journey-hero-badge"><span>●</span><strong>Network operating</strong><small>54 stations · 4 corridors</small></div></section>
<div class="booking-progress" aria-label="Ticket booking progress"><div class="active"><span>1</span><strong>Select route</strong><small>Choose your stations</small></div><i></i><div class="<%= result && result.valid ? 'active' : '' %>"><span>2</span><strong>Review fare</strong><small>Check journey details</small></div><i></i><div><span>3</span><strong>Pay & travel</strong><small>Receive your QR ticket</small></div></div>
<section class="journey-layout"><div class="journey-main">
  <form class="journey-planner-card" action="/fare" method="POST">
    <div class="journey-card-heading"><div><span class="eyebrow">Plan a new trip</span><h2>Select your route</h2></div><a href="/route">View network map ↗</a></div>
    <div class="journey-route-inputs">
      <div class="station-field origin-field"><span class="field-marker"></span><label for="start-station">From</label><input class="station-filter" type="search" placeholder="Type to filter stations" data-filter-select="start-station" aria-label="Filter starting stations"><select id="start-station" name="startStation" required data-station-option><option value="">Choose starting station</option><% allStations.forEach(station => { %><option value="<%= station %>" <%= query.startStation === station ? 'selected' : '' %>><%= station.replace(/_/g, ' ') %></option><% }) %></select></div>
      <button class="journey-swap" type="button" data-swap-stations aria-label="Swap stations">⇅</button>
      <div class="station-field destination-field"><span class="field-marker"></span><label for="end-station">To</label><input class="station-filter" type="search" placeholder="Type to filter stations" data-filter-select="end-station" aria-label="Filter destination stations"><select id="end-station" name="endStation" required data-station-option><option value="">Choose destination station</option><% allStations.forEach(station => { %><option value="<%= station %>" <%= query.endStation === station ? 'selected' : '' %>><%= station.replace(/_/g, ' ') %></option><% }) %></select></div>
    </div>
    <div class="popular-routes"><span>Popular routes</span><div><button type="button" data-quick-from="VASTRAL_GAM" data-quick-to="THALTEJ_GAM">Vastral Gam → Thaltej Gam</button><button type="button" data-quick-from="APMC" data-quick-to="MOTERA_STADIUM">APMC → Motera Stadium</button><button type="button" data-quick-from="MOTERA_STADIUM" data-quick-to="MAHATMA_MANDIR">Motera → Mahatma Mandir</button><button type="button" data-quick-from="GNLU" data-quick-to="GIFT_CITY">GNLU → GIFT City</button></div></div>
    <div class="journey-form-footer"><p><span>✓</span> Fare and route are calculated before payment.</p><button type="submit">Find route & fare <span>→</span></button></div>
  </form>
  <% if (result) { %><% if (result.valid) { %>
    <section class="journey-result-card">
      <div class="result-head"><div><span class="eyebrow">Recommended journey</span><h2><%= query.startStation.replace(/_/g, ' ') %> <b>→</b> <%= query.endStation.replace(/_/g, ' ') %></h2></div><span class="result-status">Available</span></div>
      <div class="journey-metrics"><div><span>Distance</span><strong><%= result.distance.toFixed(2) %> km</strong></div><div><span>Stations</span><strong><%= result.stops %> stops</strong></div><div><span>Est. journey</span><strong>~<%= Math.max(3, result.stops * 2) %> min</strong></div><div class="fare-metric"><span>Total fare</span><strong>₹<%= result.totalPrice %></strong></div></div>
      <div class="journey-route-detail"><div class="route-endpoint"><i class="route-origin"></i><div><small>Board at</small><strong><%= query.startStation.replace(/_/g, ' ') %></strong><span><%= result.linesUsed[0] %></span></div></div><% result.interchanges.forEach(change => { %><div class="route-change"><i>⇄</i><div><small>Change train at</small><strong><%= change.station.replace(/_/g, ' ') %></strong><span><%= change.fromLine %> → <%= change.toLine %></span></div></div><% }) %><div class="route-endpoint"><i class="route-destination"></i><div><small>Exit at</small><strong><%= query.endStation.replace(/_/g, ' ') %></strong><span><%= result.linesUsed[result.linesUsed.length - 1] %></span></div></div></div>
      <% if (!result.interchanges.length) { %><div class="direct-alert"><strong>Direct service</strong><span>No train change is required.</span></div><% } %>
      <details class="all-stops"><summary>View all <%= result.journey.length %> stations <span>⌄</span></summary><ol><% result.journey.forEach((station, index) => { %><li><span><%= index + 1 %></span><%= station.replace(/_/g, ' ') %></li><% }) %></ol></details>
      <div class="checkout-row"><div><small>Payable amount</small><strong>₹<%= result.totalPrice %></strong><span>Secure payment · QR ticket issued instantly</span></div><% if (currentUser && paymentConfigured) { %><button id="pay-button" data-start="<%= query.startStation %>" data-end="<%= query.endStation %>">Proceed to pay ₹<%= result.totalPrice %> →</button><% } else if (!currentUser) { %><a class="journey-login-button" href="/login">Log in to purchase</a><% } %></div>
      <% if (currentUser && paymentConfigured) { %><p id="payment-message" class="payment-message"></p><% } else if (currentUser) { %><p class="alert error">Razorpay test keys are not configured. Add them to your .env file to enable payment.</p><% } %>
    </section>
  <% } else { %><div class="journey-error"><span>!</span><div><h3>We couldn’t plan that route</h3><p><%= result.message %></p></div></div><% } %><% } %>
</div>
<aside class="journey-sidebar"><section class="travel-now-card"><span class="live-dot"></span><div><small>Planning for</small><strong id="journey-current-date">Today</strong><span id="journey-current-time">Current time</span></div><a href="/timetable">Check trains</a></section><section class="travel-card"><span class="eyebrow">Ticket information</span><h3>Travel with confidence</h3><ul><li><i>✓</i><div><strong>Digital QR ticket</strong><span>Delivered immediately after payment</span></div></li><li><i>✓</i><div><strong>180-minute validity</strong><span>Enter within the ticket validity window</span></div></li><li><i>✓</i><div><strong>Secure checkout</strong><span>Card and UPI payments via Razorpay</span></div></li></ul></section><section class="journey-shortcuts"><a href="/nearest-station"><span>⌖</span><div><strong>Nearest station</strong><small>Use your current location</small></div><b>›</b></a><a href="/tickets"><span>▣</span><div><strong>My tickets</strong><small>Open active QR tickets</small></div><b>›</b></a></section><section class="journey-help-card"><span>?</span><div><strong>Need help planning?</strong><p>Check the complete station map and operating timetable.</p><a href="/timetable">View service timetable →</a></div></section><section class="journey-notice"><strong>Travel reminder</strong><p>Keep the original QR ticket open for entry and exit gates.</p></section></aside></section>
<% if (result && result.valid && currentUser && paymentConfigured) { %><script src="https://checkout.razorpay.com/v1/checkout.js"></script><% } %>
<%- include('partials/footer') %>
