PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017/ahmedabad_metro
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-value
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-google-app-password
SUPPORT_EMAIL=support@example.com
TICKET_VALID_MINUTES=180
ADMIN_EMAIL=admin@metro.com
ADMIN_PASSWORD=change-this-password
# Recommended in production instead of ADMIN_PASSWORD: a bcrypt hash
ADMIN_PASSWORD_HASH=

# ImageKit (only needed when media upload/delivery is enabled)
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
