{
  "name": "ahmedabad-metro-fullstack",
  "version": "1.0.0",
  "description": "Ahmedabad Metro fare and route app built with Node.js, Express, MongoDB, and EJS",
  "main": "server.js",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js && node --check routes/index.js && node --check config/env.js"
  },
  "keywords": [
    "ahmedabad",
    "metro",
    "node",
    "express",
    "mongodb",
    "ejs"
  ],
  "author": "Ahmedabad Metro Dashboard contributors",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "mongoose": "^8.8.3",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
