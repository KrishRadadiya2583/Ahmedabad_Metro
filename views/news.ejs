<%- include('partials/header') %>
<section class="news-hero"><div><span class="eyebrow">Network journal</span><h1>News & stories</h1><p>Official project milestones, service information and simple guides for travelling on Ahmedabad Metro.</p></div><div class="news-hero-mark">N</div></section>
<section class="featured-news"><div class="featured-copy"><span class="news-tag">Latest expansion</span><h2>Metro connectivity is growing beyond the current network.</h2><p>Airport connectivity, GIFT City extensions and western expansion are moving through planning, consultancy and construction stages.</p><a href="https://www.gujaratmetrorail.com/project-overview2/" target="_blank" rel="noopener">View official project overview →</a></div><img src="<%= assetUrl('ahmedabad-city.jpg') %>" alt="Ahmedabad city and Atal Bridge"></section>
<section class="news-section"><div class="section-heading-row"><div><span class="eyebrow">Official updates</span><h2>Latest from the network</h2></div><span>Updated August 2026</span></div><div class="news-grid"><% newsItems.forEach(item => { %><article class="news-card"><div><span class="news-tag"><%= item.tag %></span><time><%= item.date %></time></div><h3><%= item.title %></h3><p><%= item.summary %></p><a href="<%= item.url %>" target="_blank" rel="noopener">Read official update →</a></article><% }) %></div></section>
<section class="guide-section"><div class="section-heading-row"><div><span class="eyebrow">Passenger guides</span><h2>Travel better</h2></div></div><div class="guide-grid"><article><span>01</span><h3>Using a digital ticket</h3><p>Buy your ticket before entry, keep the original QR available and scan it at the origin station gate.</p></article><article><span>02</span><h3>Changing metro lines</h3><p>Use Old High Court for the Phase 1 interchange and GNLU for the GIFT City branch.</p></article><article><span>03</span><h3>Ticket validity</h3><p>Digital QR tickets are valid for entry within 180 minutes of issue under current GMRC fare rules.</p></article></div></section>
<%- include('partials/footer') %>
