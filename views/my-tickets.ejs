<%- include('partials/header') %><section class="hero compact"><h1>My Tickets</h1><p>Your ticket purchase history.</p></section><section class="card">
<% if (tickets.length) { %><div class="ticket-list"><% tickets.forEach(ticket => { const expired = now >= ticket.expiresAt; %><a class="ticket-row" href="/tickets/<%= ticket._id %>"><div><strong><%= ticket.startStation %> → <%= ticket.endStation %></strong><span><%= new Date(ticket.paidAt).toLocaleString('en-IN') %></span></div><div><span class="status <%= expired ? 'expired' : 'active' %>"><%= expired ? 'Expired' : 'Active' %></span><strong>₹<%= ticket.totalPrice %></strong></div></a><% }) %></div><% } else { %><p>You have not purchased any tickets yet. <a href="/fare">Buy your first ticket</a>.</p><% } %>
</section><%- include('partials/footer') %>
