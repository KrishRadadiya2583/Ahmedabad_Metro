<section class="network-map-panel <%= compact ? 'network-map-compact' : 'network-map-detailed' %>" aria-labelledby="<%= compact ? 'landing-map-title' : 'route-map-title' %>">
  <div class="network-map-heading">
    <div><span class="eyebrow">Schematic network map</span><h2 id="<%= compact ? 'landing-map-title' : 'route-map-title' %>">Ahmedabad Metro at a glance</h2><p>Follow the coloured corridors and change at Old High Court, Motera Stadium or GNLU.</p></div>
    <% if (compact) { %><a href="/login">Sign in to explore routes →</a><% } else { %><a href="/fare">Plan a journey →</a><% } %>
  </div>
  <div class="network-map-scroll" role="img" aria-label="Schematic Ahmedabad Metro map showing the East-West, North-South, Phase 2 and GIFT City lines">
    <%
      const blueLine = routeLines.find(line => line.color === 'blue');
      const redLine = routeLines.find(line => line.color === 'red');
      const violetLine = routeLines.find(line => line.color === 'violet');
      const greenLine = routeLines.find(line => line.color === 'green');
      const stationAliases = { KALUPUR_RAILWAY_STATION: 'Kalupur Metro Station', STADIUM: 'S P Stadium', COMMERCE_SIX_ROADS: 'Commerce Six Road', RAJIV_NAGAR: 'Rajivnagar', SABARMATI_RAILWAY_STATION: 'Sabarmati Railway Station', KOBA_GAAM: 'Koba Gam', GIFT_CITY: 'GIFT City' };
      const stationLabel = station => stationAliases[station] || station.split('_').map(word => ['APMC', 'AEC', 'GNLU', 'PDEU'].includes(word) ? word : word.charAt(0) + word.slice(1).toLowerCase()).join(' ');
      const blueX = index => 100 + index * 105;
      const blueY = 520;
      const redX = blueX(redLine.stations.indexOf('OLD_HIGHCOURT'));
      const redY = index => 790 - index * 45;
      const violetX = index => redX + index * 60;
      const violetY = redY(redLine.stations.indexOf('MOTERA_STADIUM'));
      const gnluX = violetX(violetLine.stations.indexOf('GNLU'));
    %>
    <svg class="network-map-svg network-map-complete" viewBox="0 0 2400 900" xmlns="http://www.w3.org/2000/svg">
      <style>.map-grid path{fill:none;stroke:#dfe6f0;stroke-width:1;stroke-dasharray:5 9}.metro-track{fill:none;stroke-width:14;stroke-linecap:round;stroke-linejoin:round}.metro-track.blue{stroke:#1558d6}.metro-track.red{stroke:#cc3544}.metro-track.violet{stroke:#7651c9}.metro-track.green{stroke:#168b62}.map-stations circle{fill:#fff;stroke-width:5}.blue-stations circle{stroke:#1558d6}.red-stations circle{stroke:#cc3544}.violet-stations circle{stroke:#7651c9}.green-stations circle{stroke:#168b62}.map-labels text{fill:#253650;font:700 13px Inter,"Segoe UI",Arial,sans-serif;paint-order:stroke;stroke:#f5f8fc;stroke-width:5px;stroke-linejoin:round}.map-labels .interchange-label{font-weight:900}</style>
      <rect width="2400" height="900" fill="#f5f8fc"/>
      <g class="map-grid"><path d="M0 160H2400M0 340H2400M0 520H2400M0 700H2400"/><path d="M300 0V900M700 0V900M1100 0V900M1500 0V900M1900 0V900M2300 0V900"/></g>
      <path class="metro-track blue" d="M<%= blueX(0) %> <%= blueY %>H<%= blueX(blueLine.stations.length - 1) %>"/>
      <path class="metro-track red" d="M<%= redX %> <%= redY(0) %>V<%= redY(redLine.stations.length - 1) %>"/>
      <path class="metro-track violet" d="M<%= violetX(0) %> <%= violetY %>H<%= violetX(violetLine.stations.length - 1) %>"/>
      <path class="metro-track green" d="M<%= gnluX %> <%= violetY %>L<%= gnluX + 150 %> 340H<%= gnluX + 350 %>"/>

      <g class="map-stations blue-stations"><% blueLine.stations.forEach((station, index) => { %><circle cx="<%= blueX(index) %>" cy="<%= blueY %>" r="<%= station === 'OLD_HIGHCOURT' ? 12 : 7 %>"/><% }) %></g>
      <g class="map-stations red-stations"><% redLine.stations.forEach((station, index) => { %><circle cx="<%= redX %>" cy="<%= redY(index) %>" r="<%= ['OLD_HIGHCOURT', 'MOTERA_STADIUM'].includes(station) ? 12 : 7 %>"/><% }) %></g>
      <g class="map-stations violet-stations"><% violetLine.stations.forEach((station, index) => { %><circle cx="<%= violetX(index) %>" cy="<%= violetY %>" r="<%= ['MOTERA_STADIUM', 'GNLU'].includes(station) ? 12 : 7 %>"/><% }) %></g>
      <g class="map-stations green-stations"><circle cx="<%= gnluX %>" cy="<%= violetY %>" r="12"/><circle cx="<%= gnluX + 150 %>" cy="340" r="7"/><circle cx="<%= gnluX + 350 %>" cy="340" r="8"/></g>

      <g class="map-labels full-map-labels">
        <% blueLine.stations.forEach((station, index) => { if (station !== 'OLD_HIGHCOURT') { %><text transform="translate(<%= blueX(index) - 7 %> <%= blueY + 27 %>) rotate(48)"><%= stationLabel(station) %></text><% } }) %>
        <% redLine.stations.forEach((station, index) => { if (station !== 'OLD_HIGHCOURT' && station !== 'MOTERA_STADIUM') { %><text x="<%= redX - 18 %>" y="<%= redY(index) + 5 %>" text-anchor="end"><%= stationLabel(station) %></text><% } }) %>
        <text x="<%= redX - 18 %>" y="<%= blueY - 18 %>" text-anchor="end" class="interchange-label">Old High Court</text>
        <% violetLine.stations.forEach((station, index) => { %><text transform="translate(<%= violetX(index) - 6 %> <%= violetY - 22 %>) rotate(-48)" class="<%= ['MOTERA_STADIUM', 'GNLU'].includes(station) ? 'interchange-label' : '' %>"><%= stationLabel(station) %></text><% }) %>
        <text x="<%= gnluX + 150 %>" y="370" text-anchor="middle">PDEU</text><text x="<%= gnluX + 350 %>" y="370" text-anchor="middle">GIFT City</text>
      </g>
    </svg>
  </div>
  <div class="map-legend"><span><i class="blue"></i>East–West</span><span><i class="red"></i>North–South</span><span><i class="violet"></i>Motera–Mahatma Mandir</span><span><i class="green"></i>GIFT branch</span><small>Large rings indicate interchange stations · Map is schematic, not geographical</small></div>
  <div class="complete-network-map">
    <div class="complete-map-title"><span>Complete station map</span><strong>All <%= new Set(routeLines.flatMap(line => line.stations)).size %> stations</strong><small>Scroll each corridor sideways to view every stop.</small></div>
    <% routeLines.forEach(line => { %>
      <div class="complete-line-row line-row-<%= line.color %>">
        <div class="complete-line-name"><i></i><span><strong><%= line.name %></strong><small><%= line.stations.length %> stations</small></span></div>
        <div class="complete-line-scroll">
          <ol class="complete-line-stations" style="--station-count:<%= line.stations.length %>">
            <% line.stations.forEach(station => { const interchange = ['OLD_HIGHCOURT', 'MOTERA_STADIUM', 'GNLU'].includes(station); %>
              <li class="<%= interchange ? 'complete-interchange' : '' %>"><span class="station-dot"></span><strong><%= station.replace(/_/g, ' ') %></strong><% if (interchange) { %><small>Interchange</small><% } %></li>
            <% }) %>
          </ol>
        </div>
      </div>
    <% }) %>
  </div>
</section>
